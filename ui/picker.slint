import { LineEdit, ScrollView } from "std-widgets.slint";
import "../fonts/inter.ttf";

export struct Meme {
    name: string,
    thumb: image,
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback clicked();

    height: 32px;
    width: 88px;
    border-radius: 5px;
    background: touch.has-hover ? #303030 : #202020;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {root.clicked()}
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Image {
            source: root.icon;
            colorize: touch.has-hover ? #fff : #C0C0C0;
            width: 14px;
            image-fit: contain;
        }

        Text {
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 13px;
            color: touch.has-hover ? #fff : #C0C0C0;
            font-family: "Inter";
            text: root.label;
        }
    }

}

component windowAction inherits Rectangle {
    in property <image> icon;
    callback clicked();

    height: 32px;
    width: 32px;
    border-radius: 5px;
    background: touch.has-hover ? #ff0000 : #202020;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {root.clicked()}
    }
    Rectangle {
        Text {
            vertical-alignment: center;
            horizontal-alignment: center;
            Image {
                source: root.icon;
                colorize: touch.has-hover ? #fff : #C0C0C0;
                width: 24px;
                image-fit: contain;
            }
        }
    }
}

component MemeBox inherits Rectangle {
    in property <image> thumb;
    in property <bool> selected;
    background: #202020;
    border-radius: 6px;
    border-width: selected ? 2px : 0px;
    border-color:#fff;
    clip: true;

    Image {
        source: root.thumb;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}

component MemeGrid inherits Rectangle {
    in property <[Meme]> memes;

    in property <int> selected-index;
    callback picked(int);

    property <int> cols: 4;
    property <length> gap: 8px;
    // 12px reserved for the scrollbar
    property <length> cell: (self.width - 12px - (cols - 1) * gap) / cols;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: root.width;
        viewport-height: ceil(memes.length / cols) * (root.cell + gap);

        for meme[i] in memes: MemeBox {
            x: mod(i, cols) * (root.cell + gap);
            y: floor(i / cols) * (root.cell + gap);
            selected: i == root.selected-index;
            width: root.cell;
            height: root.cell;
            thumb: meme.thumb;

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

export component Picker inherits Window {

    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <[Meme]> memes;
    callback close();

    in-out property <int> selected-index: 0;



    FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if(event.text == Key.Escape){
                root.close();
                return accept;
            }
            if(event.text == Key.LeftArrow){

                if(root.selected-index <= 0){
                    root.selected-index = root.memes.length - 1;
                }else{
                    root.selected-index = root.selected-index - 1;
                }
                debug("index is now", root.selected-index);
                return accept;
            }
            if(event.text == Key.RightArrow){
                if(root.selected-index >= root.memes.length - 1){
                    root.selected-index =  0;
                }else{
                    root.selected-index = root.selected-index + 1;
                }
                debug("index is now", root.selected-index);
            }
            reject;
        }


        Rectangle {
            width: 488px;
            height: 325px;
            background: #000000;
            border-width: 2px;
            border-color: #171717;
            border-radius: 5px;
            PillButton {
                x: 12px;
                y: 12px;
                label: "Uploads";
                icon: @image-url("../assets/uploadicon.svg");
            }
            PillButton {
                x: 110px;
                y: 12px;
                label: "Pinterest";
                icon: @image-url("../assets/pinteresticon.svg");
            }
            windowAction {
                y: 12px;
                x: 444px;
                icon: @image-url("../assets/xicon.svg");
                clicked => {
                    root.close();
                }
            }

            MemeGrid {
                x: 10px;
                y: 52px;
                width: parent.width - 20px;
                height: parent.height - 62px;
                memes: root.memes;
                selected-index: root.selected-index;
            }
            // ScrollView {
            //     x: 10px;
            //     y: 50px; // below the Uploads/Pinterest row
            //     width: parent.width - 20px;
            //     height: parent.height - 60px;
            // }
        }


    }
}