import "../fonts/inter.ttf";


component NavSelector inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback clicked();

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {root.clicked()}
    }

    background: touch.has-hover ? #242424 : #202020;


    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Image {
            source: root.icon;
            // colorize: #C0C0C0;
            colorize: touch.has-hover ? #fff : #C0C0C0;
            width: 18px;
            image-fit: contain;
        }
        Text {
            vertical-alignment: center;
            font-family: "Inter";
            font-size: 13px;
            text: root.label;
        }
    }

}

export component SettingsWindow inherits Window {
    callback pickfolder();
    callback pickuploads();
    callback reset();
    in-out property <string> folder-path: "";

    title: "flexmeme-settings";
    width: 391px;
    height: 626px;
    default-font-family: "Inter";
    VerticalLayout {
        spacing: 20px;
        Rectangle {
            height: 47px;
            width: 391px;
            background: #0D0D0D;
            HorizontalLayout {
                horizontal-stretch: 1;
                NavSelector {
                    label: "Pinterest";
                    icon: @image-url("../assets/pinteresticon.svg");
                }
                Rectangle {
                    width: 1px;
                    background: #3a3a3a;
                }
                NavSelector {
                    icon: @image-url("../assets/uploadicon.svg");
                    label: "Upload";
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 360px;
                height: 10px;
                spacing: 10px;
                Text {
                    text: "Select Storage Folder";
                }
                Rectangle {
                    width: 360px;
                    height: 40px;
                    background: touch.has-hover ? #242424 :#202020;
                    border-radius: 3px;
                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {root.pickfolder()}
                    }

                    

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Image {
                            source: root.folder-path == "" ? @image-url("../assets/plusicon.svg") : @image-url("../assets/foldericon.svg");
                            width: 18px;
                            colorize: #fff;
                        }
                        Text {
                            vertical-alignment: center;
                            text: root.folder-path == "" ? "Click to select folder" : root.folder-path;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: 45px;
                        border-radius: 5px;
                        background: button.has-hover ? #242424 : transparent;
                        button := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {root.reset()}
                        }

                        
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                vertical-alignment: center;
                                font-size: 12px;
                                text: "Reset";
                            }
                        }
                    }
                }
                Rectangle {
                    width: 360px;
                    height: 40px;
                    background: root.folder-path != "" ? upload.has-hover ? #242424 :#202020 : #1b1a1a;
                    border-radius: 3px;
                    upload := TouchArea {
                        mouse-cursor: pointer;
                        enabled: root.folder-path != "";
                        clicked => {root.pickuploads()}
                    }

                    

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Image {
                            source: @image-url("../assets/uploadicon.svg");
                            width: 18px;
                            colorize: #fff;
                        }
                        Text {
                            vertical-alignment: center;
                            text: root.folder-path != "" ? "Upload Images" : "Please select folder";
                        }
                    }
                }
            }
        }
    }


}